{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Melkor Viewer",
  "version": "2.0.0-dev",
  "identifier": "dev.melkor.viewer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:8771",
    "beforeDevCommand": "bun serve.js",
    "beforeBuildCommand": "bun make-static-demo.js && bun make-4d-demo.js && bun stage-dist.js"
  },
  "app": {
    "windows": [
      {
        "title": "Melkor Viewer",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": [
        "viewer"
      ],
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "base-uri": "'none'",
        "connect-src": "'self' data: ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "manifest-src": "'none'",
        "media-src": "'none'",
        "object-src": "'none'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self'",
        "worker-src": "'self' blob: data:"
      },
      "headers": {
        "Permissions-Policy": "camera=(), geolocation=(), microphone=(), payment=(), usb=()",
        "X-Content-Type-Options": "nosniff"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
