{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melkor.dev/schemas/format-profile-v1.json",
  "title": "Melkor format profile v1",
  "description": "A format profile is descriptive data. It records the exact semantic rules for one Gaussian splat format.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "container",
    "read_containers",
    "write_containers",
    "status",
    "description",
    "coordinate_system",
    "length_unit",
    "quaternion_order",
    "quaternion_normalized",
    "scale_domain",
    "scale_constraint",
    "opacity_domain",
    "sh",
    "required_properties"
  ],
  "oneOf": [
    {
      "required": ["color_space"]
    },
    {
      "required": ["color_spaces"]
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:-]*$"
    },
    "container": {
      "type": "string",
      "enum": [
        "ply",
        "spz",
        "gltf",
        "glb"
      ]
    },
    "read_containers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "ply",
          "spz",
          "gltf",
          "glb"
        ]
      }
    },
    "write_containers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "ply",
          "spz",
          "gltf",
          "glb"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "stable",
        "release-candidate",
        "experimental",
        "legacy"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "commit",
        "pinned_in"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "pinned_in": {
          "type": "string"
        }
      }
    },
    "coordinate_system": {
      "type": "string",
      "minLength": 1
    },
    "length_unit": {
      "type": "string",
      "minLength": 1
    },
    "quaternion_order": {
      "type": "string",
      "enum": [
        "xyzw",
        "wxyz"
      ]
    },
    "quaternion_normalized": {
      "type": "boolean"
    },
    "scale_domain": {
      "type": "string",
      "enum": [
        "linear",
        "log"
      ]
    },
    "scale_constraint": {
      "type": "string",
      "minLength": 1
    },
    "opacity_domain": {
      "type": "string",
      "enum": [
        "linear",
        "logit"
      ]
    },
    "opacity_range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0
      }
    },
    "color_space": {
      "type": "string",
      "minLength": 1
    },
    "color_spaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "max_degree",
        "order",
        "phase",
        "coefficients_per_degree"
      ],
      "properties": {
        "basis": {
          "const": "real"
        },
        "max_degree": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "order": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "const": "condon-shortley"
        },
        "coefficients_per_degree": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "attribute_pattern": {
          "type": "string"
        },
        "accessor_type": {
          "type": "string"
        },
        "component_type": {
          "type": "string"
        },
        "dc_property": {
          "type": "string"
        },
        "rest_property": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "properties": {
      "type": "object",
      "additionalProperties": true
    },
    "required_properties": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "header_markers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "melkor_profile": {
          "type": "string"
        },
        "melkor_coordinate_system": {
          "type": "string"
        },
        "melkor_length_unit": {
          "type": "string"
        },
        "melkor_quaternion_order": {
          "type": "string"
        },
        "melkor_scale_domain": {
          "type": "string"
        },
        "melkor_opacity_domain": {
          "type": "string"
        },
        "melkor_color_space": {
          "type": "string"
        },
        "melkor_sh_basis": {
          "type": "string"
        },
        "melkor_sh_degree": {
          "type": "string"
        },
        "melkor_antialiased": {
          "type": "string"
        }
      }
    },
    "kernel": {
      "type": "string"
    },
    "primitive_mode": {
      "type": "string"
    },
    "material_handling": {
      "type": "string"
    },
    "representable_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "note": {
          "type": "string"
        }
      }
    },
    "upstream": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "upstream_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "license": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "release-candidate"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["spec"]
      }
    },
    {
      "if": {
        "properties": {
          "opacity_domain": {
            "const": "linear"
          }
        },
        "required": ["opacity_domain"]
      },
      "then": {
        "required": ["opacity_range"]
      }
    }
  ]
}
