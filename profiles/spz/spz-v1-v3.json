{
  "schema_version": 1,
  "profile_id": "spz:spz-v1-v3",
  "container": "spz",
  "read_containers": [
    "spz"
  ],
  "write_containers": [
    "spz"
  ],
  "status": "stable",
  "description": "The supported SPZ gzip profile for file-format versions 1 through 3.",
  "coordinate_system": "spz-rub",
  "length_unit": "unspecified-requires-explicit",
  "quaternion_order": "xyzw",
  "quaternion_normalized": true,
  "scale_domain": "log",
  "scale_constraint": "positive-after-decoding",
  "opacity_domain": "linear",
  "opacity_range": [0.0, 1.0],
  "color_space": "requires-explicit-srgb-or-linear",
  "sh": {
    "basis": "real",
    "max_degree": 3,
    "order": "degree-major-m-ascending",
    "phase": "condon-shortley",
    "coefficients_per_degree": [1, 3, 5, 7]
  },
  "properties": {
    "antialiasing_flag": true,
    "compression": "gzip",
    "max_points": 10000000,
    "position_encoding": "v1-float16-le,v2-v3-signed-fixed-point-24",
    "rotation_encoding": "v1-v2-first-three-u8,v3-smallest-three-u32",
    "scale_encoding": "quantized-log-u8",
    "opacity_encoding": "quantized-linear-u8",
    "sh_encoding": "quantized-u8"
  },
  "required_properties": [
    "magic",
    "version",
    "numPoints",
    "shDegree",
    "fractionalBits",
    "flags",
    "reserved",
    "positions",
    "opacities",
    "colors",
    "scales",
    "rotations"
  ],
  "upstream": "https://github.com/nianticlabs/spz",
  "upstream_revision": "2cf0be04d86b5f9632d9073ccbbe3b1e6a609f31"
}
